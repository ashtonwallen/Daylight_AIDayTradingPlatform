# Copy to .env. Credentials stay on this computer and are never sent to the browser.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# SIP needs a market-data subscription. IEX is limited to one exchange.
ALPACA_STOCK_FEED=sip
# Live option suggestions require OPRA. Indicative quotes are not actionable.
ALPACA_OPTION_FEED=opra
# paper or live: chooses the read-only market clock endpoint for your key type.
ALPACA_ACCOUNT=paper
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5-mini
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=
LOCAL_AI_URL=http://127.0.0.1:1234/v1
